NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Soft Storage budget for admin quota alerts (bytes). Not a hard Supabase cap.
GUEST_MEDIA_STORAGE_QUOTA_BYTES=

# Optional: pin Node process TZ (IANA). Display helpers already use America/Bogota.
# On Vercel you can also set TZ=America/Bogota in Project → Environment Variables.
# TZ=America/Bogota

# Admin access is any signed-in Supabase Auth account (src/lib/auth/require-admin.ts).
# There is no email allowlist: ADMIN_EMAIL / ADMIN_EMAILS are not read anywhere.

# Reserved for a future email phase — NOT wired yet. Admin onboarding uses
# Supabase Auth inviteUserByEmail. Leave unset; the app runs without email.
# RESEND_API_KEY=
# ADMIN_NOTIFICATION_EMAIL=
