NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Soft Storage budget for admin quota alerts (bytes). Not a hard Supabase cap.
GUEST_MEDIA_STORAGE_QUOTA_BYTES=

# Optional: pin Node process TZ (IANA). Display helpers already use America/Bogota.
# On Vercel you can also set TZ=America/Bogota in Project → Environment Variables.
# TZ=America/Bogota

# Optional extra /admin emails beyond the fixed pair in src/config/admin.ts
ADMIN_EMAIL=
ADMIN_EMAILS=

RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
